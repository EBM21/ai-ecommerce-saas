// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  stripeCustomerId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  stores             Store[]
  customers          Customer[]
}

model Store {
  id                String    @id @default(uuid())
  ownerId           String
  name              String
  subdomain         String    @unique
  customDomain      String?   @unique
  customDomainStatus DomainStatus @default(INACTIVE)
  customDomainVerificationType String? // A or CNAME
  customDomainVerificationValue String?
  isProvisioned     Boolean   @default(false)
  domainExpiresAt   DateTime?

  themeConfig       Json?
  aiAssistantConfig Json?
  stripeConnectId   String?

  email             String?
  phone             String?
  stripePublicKey   String?
  stripeSecretKey   String?

  // 👇 14-Day Free Trial Fields 👇
  plan               String    @default("free_trial")
  trialStartsAt      DateTime  @default(now())
  trialEndsAt        DateTime?
  subscriptionActive Boolean   @default(false)
  // 👆 ─────────────────────── 👆

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products          Product[]
  customers         Customer[]
  orders            Order[]
  categories        Category[]

  @@index([ownerId])
}

model Product {
  id              String    @id @default(uuid())
  storeId         String
  title           String
  description     String?
  seoMeta         Json?
  price           Decimal   @db.Decimal(10, 2)
  compareAtPrice  Decimal?  @db.Decimal(10, 2)
  inventoryCount  Int       @default(0)
  status          ProductStatus @default(DRAFT)
  images          Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  variants        ProductVariant[]
  categories      Category[]

  @@index([storeId])
}

model Category {
  id          String    @id @default(uuid())
  storeId     String
  name        String
  slug        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String
  name        String    // e.g., "Small / Red"
  sku         String?
  price       Decimal?  @db.Decimal(10, 2) // Optional override
  inventory   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Customer {
  id        String    @id @default(uuid())
  storeId   String
  userId    String?
  email     String
  name      String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders    Order[]

  @@unique([storeId, email])
  @@index([storeId])
  @@index([userId])
}

model Order {
  id                    String    @id @default(uuid())
  storeId               String
  customerId            String
  totalAmount           Decimal   @db.Decimal(10, 2)
  status                OrderStatus @default(PENDING)
  stripePaymentIntentId String?
  shippingAddress       Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  store                 Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderItems            OrderItem[]

  @@index([storeId])
  @@index([customerId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum DomainStatus {
  INACTIVE
  PENDING
  VERIFIED
  ACTIVE
  ERROR
}

model OrderItem {
  id              String    @id @default(uuid())
  orderId         String
  productId       String
  variantId       String?
  variantName     String?
  quantity        Int
  priceAtPurchase Decimal   @db.Decimal(10, 2)

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}